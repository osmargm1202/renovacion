{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Renovacion Input Contract",
  "description": "Unified input.json schema for renovation calculation projects",
  "type": "object",
  "required": ["project", "validation", "areas", "equipment", "defaults_applied"],
  "additionalProperties": false,
  "properties": {
    "project": {
      "type": "object",
      "required": ["id", "name", "cliente", "ubicacion", "ingeniero", "codia", "empresa_calculo", "logo_empresa", "logo_cliente", "status"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "description": "Sequential local project id"
        },
        "name": {
          "type": ["string", "null"],
          "description": "Project name"
        },
        "cliente": {
          "type": ["string", "null"],
          "description": "Client name"
        },
        "ubicacion": {
          "type": ["string", "null"],
          "description": "Project location"
        },
        "ingeniero": {
          "type": ["string", "null"],
          "description": "Engineer name"
        },
        "codia": {
          "type": ["string", "null"],
          "description": "CODIA number"
        },
        "empresa_calculo": {
          "type": ["string", "null"],
          "description": "Calculation company"
        },
        "logo_empresa": {
          "type": ["string", "null"],
          "description": "Company logo URL"
        },
        "logo_cliente": {
          "type": ["string", "null"],
          "description": "Client logo URL"
        },
        "status": {
          "type": "string",
          "enum": ["draft", "calc_ready"],
          "description": "Project validation status"
        }
      }
    },
    "validation": {
      "type": "object",
      "required": ["critical_complete", "missing_critical", "missing_non_critical", "notes"],
      "additionalProperties": false,
      "properties": {
        "critical_complete": {
          "type": "boolean",
          "description": "Whether all critical fields are complete"
        },
        "missing_critical": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Paths to missing critical fields"
        },
        "missing_non_critical": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Paths to missing non-critical fields"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Validation and normalization notes"
        }
      }
    },
    "areas": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": ["id", "alias", "catalog_type", "catalog_sector", "extractor_type", "dimensions", "people", "equipment_ids", "notes"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "description": "Unique area identifier within project"
          },
          "alias": {
            "type": "string",
            "minLength": 1,
            "description": "Human-readable area name"
          },
          "catalog_type": {
            "type": "string",
            "minLength": 1,
            "description": "Canonical catalog type from rules/renovacion.json"
          },
          "catalog_sector": {
            "type": "string",
            "enum": ["terciario", "industrial", "residencial_domestico"],
            "description": "Catalog sector from rules/renovacion.json"
          },
          "extractor_type": {
            "type": "string",
            "enum": ["sencillo", "ducteable"],
            "description": "Extractor usage category. Explicit input; not inferred from capacity."
          },
          "dimensions": {
            "type": "object",
            "required": ["height_m", "volume_m3"],
            "additionalProperties": false,
            "properties": {
              "length_m": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "Length in meters (optional, preserved if provided)"
              },
              "width_m": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "Width in meters (optional, preserved if provided)"
              },
              "height_m": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "Height in meters (required)"
              },
              "area_m2": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "Area in square meters (derived or provided)"
              },
              "volume_m3": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "Volume in cubic meters (always derived)"
              }
            },
            "anyOf": [
              {
                "required": ["area_m2"]
              },
              {
                "required": ["length_m", "width_m"]
              }
            ]
          },
          "people": {
            "type": ["integer", "number", "null"],
            "minimum": 0,
            "description": "Number of people (optional in v1)"
          },
          "equipment_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Equipment serving this area"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Area-specific notes"
          }
        }
      }
    },
    "equipment": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "alias", "kind", "cantidad", "serves_area_ids", "voltage", "frequency_hz", "installation_type", "power_w", "power_kw", "airflow_cfm", "airflow_m3_h", "notes"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "description": "Unique equipment identifier within project"
          },
          "alias": {
            "type": "string",
            "minLength": 1,
            "description": "Human-readable equipment name"
          },
          "kind": {
            "type": ["string", "null"],
            "description": "Equipment functional type"
          },
          "cantidad": {
            "type": ["integer", "number", "null"],
            "minimum": 1,
            "description": "Fixed quantity (fixed-only policy for v1)"
          },
          "serves_area_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Areas served by this equipment"
          },
          "voltage": {
            "type": ["string", "number", "null"],
            "description": "Voltage (placeholder for v1)"
          },
          "frequency_hz": {
            "type": ["number", "null"],
            "minimum": 0,
            "description": "Frequency in Hz (placeholder for v1)"
          },
          "installation_type": {
            "type": ["string", "null"],
            "description": "Installation type (placeholder for v1)"
          },
          "power_w": {
            "type": ["number", "null"],
            "minimum": 0,
            "description": "Power in watts (placeholder for v1)"
          },
          "power_kw": {
            "type": ["number", "null"],
            "minimum": 0,
            "description": "Power in kilowatts (placeholder for v1)"
          },
          "airflow_cfm": {
            "type": ["number", "null"],
            "minimum": 0,
            "description": "Airflow in CFM (placeholder for v1)"
          },
          "airflow_m3_h": {
            "type": ["number", "null"],
            "minimum": 0,
            "description": "Airflow in m3/h (placeholder for v1)"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Equipment-specific notes"
          }
        }
      }
    },
    "defaults_applied": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of fields that had defaults applied"
    }
  }
}
